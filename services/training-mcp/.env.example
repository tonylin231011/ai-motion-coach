# Template only. Inject real values through the server secret manager; never commit them.
MCP_PUBLIC_URL=https://REPLACE-MCP-HOST/training-mcp/mcp
OAUTH_ISSUER=https://REPLACE-OAUTH-ISSUER/
OAUTH_JWKS_URL=https://REPLACE-OAUTH-ISSUER/.well-known/jwks.json
# Exact stable sub claim for the one authorized owner; no wildcard.
OAUTH_ALLOWED_SUBJECTS=REPLACE-OWNER-SUB
# Mounted server-side secret containing only the EXISTING CloudBase READ token.
TRAINING_READ_TOKEN_FILE=/run/secrets/training_read_token
PORT=8080
